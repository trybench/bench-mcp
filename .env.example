# bench-api base URL. Defaults to production if unset.
#   staging: https://api-staging.trybench.ai
#   local:   http://localhost:8080
BENCH_API_BASE_URL=https://api.trybench.ai

# Your Bench API key. Generate one in Bench account settings.
# Starts with "bench_sk_"; shown once at creation and unrecoverable after.
BENCH_API_KEY=bench_sk_replace_me

# How long to wait on a single bench-api request, in milliseconds.
# Default 120000. Long stages run in the background, so this bounds one
# HTTP call, not a whole evaluation.
BENCH_MCP_TIMEOUT_MS=120000

# --- Hosted mode only ---

# Transport: "stdio" (default, local — one user, key from BENCH_API_KEY)
# or "http" (hosted — many users, each supplying their own key per
# connection in the Authorization header).
# BENCH_MCP_TRANSPORT=stdio

# Port for http transport. Default 8080.
# PORT=8080

# Comma-separated hostnames the http transport will answer to. Set this
# to the public hostname in production — it enables DNS-rebinding
# protection, which is off by default.
# BENCH_MCP_ALLOWED_HOSTS=mcp.trybench.ai
